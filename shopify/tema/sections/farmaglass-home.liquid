        <rect x="13" y="28" width="8" height="6" rx="1.5" fill="url(#gd-sun)"/>
        <rect x="10" y="15.5" width="24" height="2.5" rx="1.25" fill="url(#gd-shine)"/>
    </symbol>
    <symbol id="d-rx" viewBox="0 0 48 48">
        <path d="M12 4h17l11 11v27a3 3 0 0 1-3 3H12a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z" fill="url(#gd-sky)"/>
        <path d="M29 4v9a2 2 0 0 0 2 2h9z" fill="#fff" opacity=".55"/>
        <rect x="13" y="8" width="12" height="3" rx="1.5" fill="url(#gd-shine)"/>
        <path d="M16 22v14M16 22h5a4 4 0 0 1 0 8h-5M20 30l8 8M28 30l-8 8" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <circle cx="36" cy="38" r="7" fill="url(#gd-green)"/><path d="m33 38 2 2 4-4" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </symbol>
    <symbol id="d-chat" viewBox="0 0 48 48">
        <path d="M6 12a6 6 0 0 1 6-6h24a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6H18l-9 8v-8.5A6 6 0 0 1 6 26z" fill="url(#gd-sun)"/>
        <path d="M10 10h26" stroke="url(#gd-shine)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="16" cy="19" r="2.5" fill="#fff"/><circle cx="24" cy="19" r="2.5" fill="#fff"/><circle cx="32" cy="19" r="2.5" fill="#fff"/>
    </symbol>
</svg>
