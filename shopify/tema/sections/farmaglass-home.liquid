        <rect x="6" y="26" width="16" height="16" rx="5" fill="url(#gd-sky)"/><rect x="26" y="26" width="16" height="16" rx="8" fill="url(#gd-coral)"/>
        <rect x="9" y="9" width="10" height="4" rx="2" fill="url(#gd-shine)"/><rect x="29" y="9" width="10" height="4" rx="2" fill="url(#gd-shine)"/>
