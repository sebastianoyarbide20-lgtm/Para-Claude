        <div class="dialog-top">
            <div class="dialog-tools">
                <button class="dialog-tool" type="button" id="dialog-fav" data-fav="" aria-pressed="false" aria-label="Guardar en favoritos"><svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg></button>
                <button class="dialog-tool" type="button" id="dialog-share" aria-label="Compartir producto"><svg class="icon" aria-hidden="true"><use href="#i-share"/></svg></button>
            </div>
            <button class="dialog-close" type="button" id="dialog-close" aria-label="Cerrar"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
        </div>
        <div class="dialog-img"><img id="dialog-img" src="" alt="" referrerpolicy="no-referrer"></div>
        <div class="dialog-meta" id="dialog-meta"></div>
        <h2 class="dialog-title" id="dialog-title"></h2>
        <p class="dialog-desc" id="dialog-desc"></p>
        <dl class="dialog-facts" id="dialog-facts"></dl>
        <a class="dialog-page" id="dialog-page" href="{{ routes.all_products_collection_url }}">Ver la página del producto</a>
        <div class="dialog-price-row">
            <div>
                <div class="dialog-price-old" id="dialog-price-old"></div>
                <div class="dialog-price" id="dialog-price"></div>
                <p class="dialog-cuotas" id="dialog-cuotas"></p>
            </div>
            <div class="qty-selector" role="group" aria-label="Cantidad">
                <button class="qty-btn" type="button" id="qty-minus" aria-label="Quitar uno">−</button>
                <output class="qty-value" id="qty-val" aria-live="polite">1</output>
                <button class="qty-btn" type="button" id="qty-plus" aria-label="Agregar uno">+</button>
            </div>
        </div>
        <button class="dialog-add" type="button" id="dialog-add">
            <svg class="icon" aria-hidden="true"><use href="#i-cart"/></svg>
            <span id="dialog-add-label">Agregar al carrito</span>
        </button>
        <section class="dialog-related" id="dialog-related" aria-labelledby="related-title" hidden>
            <h3 id="related-title">También te puede interesar</h3>
            <ul class="related-list" id="related-list"></ul>
        </section>
    </div>
</dialog>

<!-- BOTÓN DE ARREPENTIMIENTO -->
<dialog class="product-dialog regret-dialog" id="regret-dialog" aria-labelledby="regret-title">
    <div class="dialog-inner">
        <div class="dialog-top">
            <h2 id="regret-title">Botón de arrepentimiento</h2>
            <button class="dialog-close" type="button" data-close aria-label="Cerrar"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
        </div>
        {%- form 'contact', id: 'regret-form', class: 'regret-form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[Tipo]" value="Botón de arrepentimiento">
            <input type="hidden" name="contact[Código de trámite]" id="regret-code-field">
            <p class="regret-intro">Tenés 10 días corridos desde que recibiste tu compra para cancelarla, sin costo y sin dar explicaciones. Te damos un código de trámite para hacer el seguimiento.</p>
            <div class="addr-field">
                <label for="regret-order">Número de pedido</label>
                <input id="regret-order" name="contact[Pedido]" type="text" list="regret-orders" autocomplete="off" placeholder="Ej.: #1001" aria-describedby="regret-order-help">
                <datalist id="regret-orders"></datalist>
                <small class="field-help" id="regret-order-help">Lo encontrás en el email de confirmación o en Mi cuenta.</small>
            </div>
            <div class="addr-field">
                <label for="regret-email">Email de la compra</label>
                <input id="regret-email" name="contact[email]" type="email" autocomplete="email" inputmode="email" placeholder="nombre@correo.com" value="{{ customer.email }}">
            </div>
            <div class="addr-field">
                <label for="regret-reason">Motivo <span class="optional">(opcional)</span></label>
                <textarea id="regret-reason" name="contact[body]" rows="3"></textarea>
            </div>
            <p class="rx-err" id="regret-err" aria-live="polite"></p>
            {%- if form.errors -%}<div class="rx-err" data-form-errors="regret" hidden>{{ form.errors | default_errors }}</div>{%- endif -%}
            <button class="dialog-add" type="submit">Solicitar la cancelación</button>
        {%- endform -%}
        <div class="regret-done" id="regret-done" hidden tabindex="-1">
            <span class="rx-done-ico" aria-hidden="true"><svg class="icon"><use href="#i-check"/></svg></span>
            <h3>Recibimos tu solicitud</h3>
            <p>Tu código de trámite es <span class="rx-code" id="regret-code"></span>. <span id="regret-done-text"></span></p>
            <button class="dialog-add" type="button" data-close>Listo</button>
        </div>
    </div>
</dialog>

<!-- BANDA DE BIENVENIDA -->
<aside class="welcome-bar" id="welcome-bar" aria-label="Beneficio de bienvenida">
    <p><strong>Primera compra:</strong> 20 % off con <code>NUEVO20</code></p>
    <button class="welcome-copy" type="button" id="welcome-copy">Usar código</button>
    <button class="welcome-close" type="button" id="welcome-close" aria-label="Cerrar"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
</aside>

<button class="to-top" type="button" id="to-top" aria-label="Volver arriba"><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg></button>

{% render 'farmaglass-datos' %}
<script src="{{ 'fg-shop.js' | asset_url }}" defer></script>
<script src="{{ 'farmaglass-home.js' | asset_url }}" defer></script>

