<a class="skip-link" href="#catalogo">Ir al catálogo</a>

<!-- HEADER -->
<header class="global-header">
    <div class="header-inner">
        <a class="brand-logo" href="{{ routes.root_url }}" aria-label="FarmaGlass, inicio">
            <span class="brand-logo-icon"><svg class="icon" aria-hidden="true"><use href="#i-cross"/></svg></span>
            <span class="brand-logo-text" aria-hidden="true">Farma<span>Glass</span></span>
        </a>

        <button class="addr-btn" type="button" id="addr-btn" aria-describedby="addr-label">
            <svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg>
            <span class="addr-btn-text"><small>Entregar en</small><b id="addr-label">Ingresá tu dirección</b></span>
        </button>

        <form class="search-bar" role="search" id="search-form">
            <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
            <label for="product-search" class="sr-only">Buscar productos</label>
            <input type="search" id="product-search" placeholder="Buscá productos, marcas o farmacias" autocomplete="off"
                role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggest">
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
            <button type="button" class="search-clear" id="search-clear" aria-label="Borrar búsqueda" hidden>
                <svg class="icon" aria-hidden="true"><use href="#i-x"/></svg>
            </button>
            <div class="search-suggest" id="search-suggest" role="listbox" aria-label="Sugerencias de búsqueda" hidden></div>
        </form>

        <button class="header-icon-btn header-desk" type="button" data-account-open="favs" aria-label="Mis favoritos">
            <svg class="icon" aria-hidden="true"><use href="#i-heart"/></svg>
            <span class="count-badge" data-fav-count hidden>0</span>
        </button>
        <button class="header-icon-btn header-desk" type="button" data-account-open="orders" aria-label="Mi cuenta: pedidos, favoritos y recetas">
            <svg class="icon" aria-hidden="true"><use href="#i-user"/></svg>
        </button>
        <button class="header-icon-btn" type="button" id="header-cart-btn" data-cart-open aria-label="Carrito, 0 productos">
            <svg class="icon" aria-hidden="true"><use href="#i-cart"/></svg>
            <span class="count-badge" data-cart-count hidden>0</span>
        </button>
    </div>
    <nav class="header-cats" aria-label="Categorías">
        <ul>
            <li><button class="cat-chip cat-top" type="button" data-cat="todos" aria-pressed="true"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-grid"/></svg></span>Todo</button></li>
            <li><button class="cat-chip cat-top is-sale" type="button" data-cat="ofertas" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-tag"/></svg></span>Ofertas</button></li>
            <li><button class="cat-chip cat-top" type="button" data-cat="dermocosmetica" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-sparkle"/></svg></span>Dermocosmética</button></li>
            <li><button class="cat-chip cat-top" type="button" data-cat="cuidado" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-drop"/></svg></span>Cuidado personal</button></li>
            <li><button class="cat-chip cat-top" type="button" data-cat="farmacia" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-pill"/></svg></span>Farmacia</button></li>
            <li><button class="cat-chip cat-top" type="button" data-cat="bebes" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-baby"/></svg></span>Bebés</button></li>
            <li><button class="cat-chip cat-top" type="button" data-cat="nutricion" aria-pressed="false"><span class="cat-ico ico-tile"><svg class="duo" aria-hidden="true"><use href="#d-leaf"/></svg></span>Nutrición</button></li>
            <li><a class="cat-top store-link" href="#farmacias"><span class="cat-ico ico-tile"><svg class="icon" aria-hidden="true"><use href="#i-store"/></svg></span>Farmacias</a></li>
        </ul>
    </nav>
</header>

<main class="main-content" id="main">

    <!-- PORTADA: las farmacias de la red, una por vez, cada una con su estilo -->
    <section class="hero-stores" id="hero-stores" aria-roledescription="carrusel" aria-labelledby="hero-title">
        <h1 class="sr-only" id="hero-title">FarmaGlass: las farmacias de tu barrio, online y con envío en 2 horas</h1>
        <div class="hero-slide" id="hero-slide" aria-live="polite"></div>
        <div class="hero-switch">
            <div class="hero-switch-list" id="hero-switch" role="group" aria-label="Elegí la farmacia de la portada"></div>
            <button class="promo-nav promo-pause" type="button" id="hero-pause" aria-label="Pausar portada" aria-pressed="false">
                <svg class="icon ico-pause" aria-hidden="true"><use href="#i-pause"/></svg><svg class="icon ico-play" aria-hidden="true"><use href="#i-play"/></svg>
            </button>
        </div>
    </section>

    <!-- BANNERS SECUNDARIOS -->
    <section class="promo-carousel" aria-roledescription="carrusel" aria-label="Promociones">
        <div class="promo-track" id="promo-track">
        <article class="promo promo-baby">
            <div class="promo-text">
                <p class="promo-kicker">Bebés · 2x1</p>
                <h2 class="promo-title">Llevá 2 latas de Nido 3 y pagá 1</h2>
                <p class="promo-prices" data-promo-price="1"><span class="promo-old">$ 57.800</span><span class="promo-new">$ 28.900</span></p>
                <button class="promo-cta" type="button" data-go-cat="bebes">Ver promo <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
            </div>
            <img class="promo-img" data-promo-img="1" alt="" loading="lazy" width="160" height="160">
        </article>
        <article class="promo promo-hair">
            <div class="promo-text">
                <p class="promo-kicker">Cuidado capilar</p>
                <h2 class="promo-title">Hasta 25 % off en shampoos y máscaras</h2>
                <p class="promo-prices" data-promo-price="3"><span class="promo-from">desde</span><span class="promo-new">$ 7.280</span></p>
                <button class="promo-cta" type="button" data-go-cat="cuidado">Ver productos <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
            </div>
            <img class="promo-img" data-promo-img="5" alt="" loading="lazy" width="160" height="160">
        </article>
        <article class="promo promo-ship">
            <div class="promo-text">
                <p class="promo-kicker">Beneficio</p>
