<!doctype html>
{%- comment -%}
  FarmaGlass · layout de las páginas de farmacia (templates/collection.farmacia-*.json).
  Generado por shopify/construir-farmacias.js a partir de las páginas farmacia-*.html: no editar a mano.
{%- endcomment -%}
<html lang="es-AR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- case template.suffix %}
        {%- when 'farmacia-centro' -%}
            <title>Farmacia del Centro · La Gaceta de la Botica · Recoleta</title>
            <meta name="description" content="Farmacia del Centro, botica tradicional desde 1962 en Recoleta: agua de rosas, caléndula, glicerina, vaselina y dermocosmética de farmacia.">
            <meta name="theme-color" content="#14284B">
            <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Inter:wght@500;600;700&display=swap" rel="stylesheet">
        {%- when 'farmacia-plaza' -%}
            <title>Farmacia Plaza Palermo · After Hours 24 h</title>
            <meta name="description" content="Farmacia Plaza Palermo, abierta las 24 horas: skincare de noche, entrega a cualquier hora y tu rutina en dos preguntas.">
            <meta name="theme-color" content="#1C0A2B">
            <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800;900&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        {%- when 'farmacia-norte' -%}
            <title>Farmacia Belgrano Norte · Norte Training Club</title>
            <meta name="description" content="Farmacia Belgrano Norte: armá tu kit para entrenar, calculá tu hidratación y encontrá suplementos, protección solar y alivio muscular.">
            <meta name="theme-color" content="#0B1B3F">
            <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,800;1,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        {%- when 'farmacia-parque' -%}
            <title>Farmacia Parque Caballito · Un día en el parque</title>
            <meta name="description" content="Farmacia Parque Caballito: cuidado para bebés, chicos y toda la familia, frente a Parque Rivadavia. Armá la mochila para el parque.">
            <meta name="theme-color" content="#4E6B3D">
            <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        {%- else -%}
            <title>{{ page_title }} · FarmaGlass</title>
    {%- endcase %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if template.suffix != blank %}
    {{ template.suffix | append: '.css' | asset_url | stylesheet_tag }}
    {%- endif %}
    {{ content_for_header }}
</head>
<body>
    {{ content_for_layout }}
</body>
</html>
